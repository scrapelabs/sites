{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "sisyphus_agent": {
    "disabled": true,
    "default_builder_enabled": false,
    "planner_enabled": false,
    "replace_plan": false
  },
  "disabled_agents": ["sisyphus", "prometheus", "metis", "momus", "atlas"],
  "disabled_skills": ["playwright", "frontend-ui-ux", "git-master"],
  "disabled_mcps": ["websearch", "context7", "grep_app"],
  "disabled_commands": ["init-deep", "start-work"],
  "disabled_hooks": [
    "todo-continuation-enforcer",
    "context-window-monitor",
    "session-recovery",
    "session-notification",
    "comment-checker",
    "grep-output-truncator",
    "tool-output-truncator",
    "directory-agents-injector",
    "directory-readme-injector",
    "empty-task-response-detector",
    "think-mode",
    "anthropic-context-window-limit-recovery",
    "rules-injector",
    "auto-update-checker",
    "startup-toast",
    "keyword-detector",
    "agent-usage-reminder",
    "non-interactive-env",
    "interactive-bash-session",
    "ralph-loop",
    "claude-code-hooks",
    "auto-slash-command",
    "edit-error-recovery",
    "delegate-task-retry",
    "prometheus-md-only",
    "start-work",
    "atlas"
  ],
  "claude_code": {
    "mcp": false,
    "commands": false,
    "skills": false,
    "agents": false,
    "hooks": false,
    "plugins": false
  },
  "background_task": {
    "defaultConcurrency": 3
  },
  "git_master": {
    "commit_footer": false,
    "include_co_authored_by": false
  },
  "auto_update": false,
  "agents": {
    "oracle": {
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "webfetch": "ask",
        "external_directory": "ask"
      }
    },
    "librarian": {
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "webfetch": "ask",
        "external_directory": "ask"
      }
    },
    "explore": {
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "webfetch": "ask",
        "external_directory": "ask"
      }
    },
    "multimodal-looker": {
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "webfetch": "ask",
        "external_directory": "ask"
      }
    }
  }
}
