# ============================================================================
# Permitlify environment configuration (TEMPLATE)
#
# Copy this file to ".env" and fill in real values.
#
# IMPORTANT: ".env" is git-ignored so your real values never get committed.
# IMPORTANT: values in .env take PRECEDENCE over machine / system environment
#            variables (the app loads .env with override=True). Only put keys
#            here that you want .env to be the single source of truth for.
# ============================================================================

# Database connection. The app reads SUPABASE_DATABASE_URL for ALL database
# access, whether it points at cloud Supabase or your LOCAL Postgres.
# For the local Postgres 17 install, the format is:
#   postgresql://postgres:<PG_SUPERPASS>@127.0.0.1:5432/<LOCAL_DB>
# Keep the password in sync with PG_SUPERPASS in db_config.bat.
SUPABASE_DATABASE_URL=postgresql://postgres:ChangeThisToAStrongPassword123@127.0.0.1:5432/permitlify

# Local free GPT-OSS parser/rewrite endpoint. Runs as the GptOss20B Windows
# service on the same server; no DigitalOcean inference key is required.
GPT_OSS_BASE_URL=http://127.0.0.1:8010/v1
GPT_OSS_MODEL=gpt-oss-20b-mxfp4
