# ============================================================================
#  Multi-site reverse proxy (Caddy)  --  the SINGLE port-80 front door.
#
#  HOW THE TRAFFIC FLOWS:
#     visitor --https--> Cloudflare --http:80--> THIS Caddy --> the right app
#
#  Cloudflare terminates HTTPS for visitors and forwards to this server on
#  plain HTTP port 80. Caddy listens on :80, looks at the requested domain,
#  and forwards each domain to its own app on a private loopback port.
#
#  WHY auto_https off + X-Forwarded-Proto https:
#   * Cloudflare already supplies the certificate, so Caddy must NOT try to
#     fetch its own (auto_https off) -- otherwise it fights Cloudflare on :443.
#   * Visitors are ALWAYS https, but Cloudflare->server is http, so we tell
#     each backend "this was https" via X-Forwarded-Proto. The Django apps
#     force HTTPS and would 301-redirect-loop forever without this header.
#
#  ADD A NEW SITE: copy a site block below, change the domain(s) and the
#  127.0.0.1:<port>, then run  reload_caddy.bat  (zero downtime).
# ============================================================================

{
        # Cloudflare does TLS for us -- don't let Caddy request its own certs.
        auto_https off
        # Local admin API used by `caddy reload`. Keep it on loopback only.
        admin localhost:2019
}

# --- Site 1: Permitlify -> 127.0.0.1:8000 -----------------------------------
#  Lists every domain that should reach this app (live domain is permitlify.com;
#  permitdaily.com kept too in case it also points here).
http://permitlify.com, http://www.permitlify.com, http://permitdaily.com, http://www.permitdaily.com {
        reverse_proxy 127.0.0.1:8000 {
                header_up X-Forwarded-Proto https
        }
}

# --- Site 2 (EXAMPLE -- copy this block for each new site) ------------------
# http://site2.com, http://www.site2.com {
#       reverse_proxy 127.0.0.1:8001 {
#               header_up X-Forwarded-Proto https
#       }
# }
